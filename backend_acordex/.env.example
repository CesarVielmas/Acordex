# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=*

# PostgreSQL Database (Prisma)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=backend_acordex
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/backend_acordex?schema=public"

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT
JWT_SECRET=super-secret-production-grade-jwt-key-change-in-prod
JWT_EXPIRATION=1d
